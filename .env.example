# Copy this file to .env and fill in your own values. Never commit .env.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dfi_db

# Security: generate your own key with `openssl rand -hex 32`
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin user created by database/seed.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: where trained models are stored (defaults to ./models)
# MODEL_PATH=

# Optional: path to the FooDrugs SQL dump (defaults to datasets/raw/FinalFooDrugs_v4.sql)
# ZENODO_SQL_PATH=

# Optional, Docker only: PostgreSQL password used by docker-compose.yml
# POSTGRES_PASSWORD=postgres
